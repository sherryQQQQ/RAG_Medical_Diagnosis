# Copy to .env and fill in your values

# Google Gemini API
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
EVAL_JUDGE_MODEL=gemini-pro-latest

# Neo4j Aura (free tier: https://neo4j.com/cloud/aura-free/)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# LangSmith (optional, for observability: https://smith.langchain.com)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=medical-graphrag
MEDICAL_RAG_LANGSMITH_TRACING=false

# Optional overrides
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
TOP_K_VECTOR=5
TOP_K_GRAPH=3
